# Set these in Vercel → Project → Settings → Environment Variables.
# App Store ID, the digits in https://apps.apple.com/app/id<THIS>. Leave empty until 1.0 is live.
NEXT_PUBLIC_APP_STORE_ID=6823512627
# Provider token from App Store Connect → App Analytics → Campaigns (the pt= value).
NEXT_PUBLIC_APP_STORE_PT=
# PostHog project API key (same project as the app). Leave empty to turn analytics off.
NEXT_PUBLIC_POSTHOG_KEY=phc_swfunL9jZfhatUansNFqhS8hz4Vh4LACtYDfvCuPkWtM
